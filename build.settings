-- build.settings für "Calc Play 1x1"

settings =
{
    ----------------------------------------------------------------------------
    -- Ausrichtung
    ----------------------------------------------------------------------------
    orientation =
    {
        -- Nur Hochformat
        default   = "portrait",
        supported = { "portrait" },
    },

    ----------------------------------------------------------------------------
    -- Android
    ----------------------------------------------------------------------------
    android =
    {
        -- Keine zusätzlichen Berechtigungen:
        -- Kein INTERNET, kein Zugriff auf Speicher, Standort usw.
        usesPermissions = {},
        package = "com.matissimo.calcplay1x1", -- Bundel-ID (nie ändern!!!)
        minSdkVersion = "21", -- Google Play verlangt mindestens diese Version
    },

    ----------------------------------------------------------------------------
    -- iOS
    ----------------------------------------------------------------------------
    iphone =
    {
        xcassets = "Images.xcassets",

        plist =
        {
            UIStatusBarHidden      = false,
            UILaunchStoryboardName = "LaunchScreen",

            -- Nur Hochformat (spiegelt die orientation-Angabe wider)
            UISupportedInterfaceOrientations =
            {
                "UIInterfaceOrientationPortrait",
            },
        },
    },

    ----------------------------------------------------------------------------
    -- Plugins (keine)
    ----------------------------------------------------------------------------
    plugins =
    {
        -- leer
    },

    ----------------------------------------------------------------------------
    -- Projekt: Dateien für bestimmte Plattformen ausschließen
    ----------------------------------------------------------------------------
    excludeFiles =
    {
        all =
        {
            "Icon.png",
            "Icon-*dpi.png",
            "Images.xcassets",
        },

        android =
        {
            "LaunchScreen.storyboardc",
        },
    },
}
